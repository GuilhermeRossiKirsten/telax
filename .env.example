# TURN é opcional. Só é usado quando as três variáveis estão definidas.
# Sem TURN, conexões P2P podem falhar em NAT simétrico / redes corporativas.
# TURN_URLS aceita várias URLs separadas por vírgula.
TURN_URLS=turn:turn.exemplo.com:3478,turns:turn.exemplo.com:5349
TURN_USERNAME=usuario
TURN_CREDENTIAL=senha

# MongoDB é opcional. Com MONGODB_URI as salas ficam no banco e todas as instâncias do servidor
# enxergam as mesmas (necessário na Vercel). Sem ela, as salas ficam na memória do processo.
# Na Vercel, conectar o banco ao projeto (Storage/Marketplace) já injeta MONGODB_URI sozinho.
# NUNCA coloque a URI real (com senha) em arquivo versionado: use .env.local ou o painel da Vercel.
MONGODB_URI=mongodb+srv://usuario:senha@cluster.exemplo.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=telax
